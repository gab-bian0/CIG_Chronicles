import Phaser from 'phaser';
import { BaseScene } from './BaseScene';
import dialogues from '../data/dialogues.json';
import docMap from '../data/maps/doc_book_cafe.json';
import pavMap from '../data/maps/pavaglione_tutorial.json';
import { GameState, type MapId } from '../core/GameState';
import { SaveManager } from '../core/SaveManager';

interface WorldInit { map?: MapId }

export class WorldScene extends BaseScene {
  private player!: Phaser.Physics.Arcade.Sprite;
  private cursors!: Phaser.Types.Input.Keyboard.CursorKeys;
  private wasd!: Record<'up' | 'down' | 'left' | 'right', Phaser.Input.Keyboard.Key>;
  private mapId: MapId = 'doc_book_cafe';
  private interactionLocked = false;

  constructor() { super('WorldScene'); }

  init(data: WorldInit): void {
    this.mapId = data.map ?? 'doc_book_cafe';
    this.interactionLocked = false;
  }

  create(): void {
    this.addBackdrop(this.mapId === 'doc_book_cafe' ? 0x392b20 : 0x304030);
    if (this.mapId === 'doc_book_cafe') this.drawCafe(); else this.drawPavaglione();
    const map = this.mapId === 'doc_book_cafe' ? docMap : pavMap;
    this.player = this.physics.add.sprite(map.spawn.x, map.spawn.y, 'pastenone');
    this.player.setCollideWorldBounds(true).setDepth(20);
    this.player.body?.setSize(22, 18).setOffset(5, 18);
    this.cursors = this.input.keyboard!.createCursorKeys();
    this.wasd = this.input.keyboard!.addKeys({ up: 'W', down: 'S', left: 'A', right: 'D' }) as typeof this.wasd;
    this.add.text(18, 16, map.name, {
      fontFamily: 'Georgia', fontSize: '22px', color: '#f5ead2',
      backgroundColor: '#00000088', padding: { x: 10, y: 6 },
    }).setDepth(50);
    this.addPrompt(this.mapId === 'doc_book_cafe'
      ? 'Raggiungi il tavolo di Gabri, J e Ciollo'
      : 'Avvicinati a Ciollo per iniziare il duello');
    this.input.keyboard?.on('keydown-P', () => SaveManager.save());
  }

  update(): void {
    if (!this.player?.body || this.interactionLocked) {
      this.player?.setVelocity(0);
      return;
    }
    const x = (this.cursors.left.isDown || this.wasd.left.isDown ? -1 : 0)
      + (this.cursors.right.isDown || this.wasd.right.isDown ? 1 : 0);
    const y = (this.cursors.up.isDown || this.wasd.up.isDown ? -1 : 0)
      + (this.cursors.down.isDown || this.wasd.down.isDown ? 1 : 0);
    const direction = new Phaser.Math.Vector2(x, y).normalize().scale(175);
    this.player.setVelocity(direction.x, direction.y);
    if (x < 0) this.player.setFlipX(true); else if (x > 0) this.player.setFlipX(false);
    this.checkTriggers();
  }

  private checkTriggers(): void {
    const { x, y } = this.player;
    if (this.mapId === 'doc_book_cafe' && Phaser.Math.Distance.Between(x, y, 690, 290) < 95) {
      this.interactionLocked = true;
      const first = !GameState.getFlag('met_cig_table');
      this.showDialogue(first ? dialogues.cig_table_first : dialogues.cig_table_repeat, () => {
        GameState.setFlag('met_cig_table');
        GameState.setFlag('quest_le_due_ciole_started');
        GameState.setFlag('tutorial_items_collected');
        this.showDialogue(dialogues.outside_challenge, () => {
          GameState.setFlag('ciollo_invited_outside');
          this.changeMap('pavaglione_tutorial');
        });
      });
    } else if (this.mapId === 'doc_book_cafe' && y > 500 && x > 400 && x < 560) {
      this.changeMap('pavaglione_tutorial');
    } else if (this.mapId === 'pavaglione_tutorial' && Phaser.Math.Distance.Between(x, y, 480, 205) < 82) {
      if (GameState.getFlag('tutorial_battle_won')) return;
      this.interactionLocked = true;
      this.scene.start('BattleScene');
    } else if (this.mapId === 'pavaglione_tutorial' && y > 505 && x > 400 && x < 560) {
      this.changeMap('doc_book_cafe');
    }
  }

  private changeMap(map: MapId): void {
    this.interactionLocked = true;
    const target = map === 'doc_book_cafe' ? docMap.spawn : pavMap.spawn;
    GameState.setPlayerPosition({ map, x: target.x, y: target.y });
    SaveManager.save();
    this.cameras.main.fadeOut(250, 0, 0, 0);
    this.time.delayedCall(270, () => this.scene.restart({ map }));
  }

  private drawCafe(): void {
    const g = this.add.graphics();
    g.fillStyle(0xc7ad82).fillRect(25, 45, 910, 465);
    g.lineStyle(2, 0x9e815b, 0.45);
    for (let x = 30; x < 940; x += 35) g.lineBetween(x, 45, x, 510);
    g.fillStyle(0x4b2d20).fillRect(40, 65, 880, 70);
    for (let x = 52; x < 900; x += 34) {
      g.fillStyle([0x9c4938, 0x315679, 0xc5a14f][Math.floor(x / 34) % 3]).fillRect(x, 78, 8, 42);
    }
    g.fillStyle(0xf1eadb).fillEllipse(690, 290, 160, 82);
    g.lineStyle(5, 0x72513a).strokeEllipse(690, 290, 160, 82);
    this.addNpcLabel(645, 245, 'Gabri'); this.addNpcLabel(700, 232, 'J'); this.addNpcLabel(752, 255, 'Ciollo');
    g.fillStyle(0x2c2019).fillRect(425, 485, 110, 25);
    this.add.text(480, 492, 'USCITA', { fontFamily: 'Arial', fontSize: '12px', color: '#f5ead2' }).setOrigin(0.5);
  }

  private drawPavaglione(): void {
    const g = this.add.graphics();
    g.fillStyle(0x71845b).fillRect(20, 40, 920, 470);
    g.fillStyle(0xb9a98b).fillEllipse(480, 300, 700, 330);
    g.lineStyle(5, 0x8b765a).strokeEllipse(480, 300, 700, 330);
    g.fillStyle(0x4d6543).fillCircle(105, 110, 55).fillCircle(850, 100, 65);
    this.add.sprite(480, 205, 'ciollo').setScale(1.3);
    this.addNpcLabel(480, 165, 'Ciollo');
    this.add.text(905, 275, GameState.getFlag('road_to_bagnara_unlocked') ? '→ BAGNARA' : 'BAGNARA\n(BLOCCATA)', {
      fontFamily: 'Arial', fontSize: '14px', color: '#f5ead2', align: 'center',
      backgroundColor: '#00000077', padding: { x: 8, y: 5 },
    }).setOrigin(0.5);
  }

  private addNpcLabel(x: number, y: number, name: string): void {
    this.add.circle(x, y + 22, 13, 0x6b3141).setDepth(5);
    this.add.text(x, y, name, { fontFamily: 'Arial', fontSize: '13px', color: '#2a1d15' }).setOrigin(0.5, 1).setDepth(6);
  }
}
