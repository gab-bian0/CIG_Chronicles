:root {
  color-scheme: dark;
  font-family: Georgia, 'Times New Roman', serif;
  background: #17130f;
  color: #f5ead2;
  font-synthesis: none;
}

* { box-sizing: border-box; }

html, body, #app {
  width: 100%;
  height: 100%;
  margin: 0;
}

body {
  display: grid;
  place-items: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 20%, #433626 0, #211a13 45%, #0d0b09 100%);
}

#app canvas {
  display: block;
  max-width: 100%;
  max-height: 100%;
  margin: auto;
  border: 1px solid #80663e;
  box-shadow: 0 18px 70px #000c;
  image-rendering: pixelated;
}
